# Local development only. Never commit your real .env file.
APP_ENV=development
APP_BASE_URL=http://localhost:8000
DATABASE_URL=sqlite:///./research_agent.db
APP_SECRET_KEY=replace-with-a-random-secret-at-least-32-characters
# Generate a 32-byte key: python -c "import base64,secrets; print(base64.urlsafe_b64encode(secrets.token_bytes(32)).decode())"
# Render can also generate an opaque random secret (>=32 chars); the app derives AES-256 from it.
TOKEN_ENCRYPTION_KEY=

# Create a public Notion OAuth integration and configure these values.
NOTION_OAUTH_CLIENT_ID=
NOTION_OAUTH_CLIENT_SECRET=
NOTION_REDIRECT_URI=http://localhost:8000/oauth/notion/callback
NOTION_API_VERSION=2026-03-11

# Tavily Search API key enables autonomous research discovery.
TAVILY_API_KEY=
# Optional deadline email digest provider (Resend). Configure both values to enable delivery.
RESEND_API_KEY=
EMAIL_FROM=Research Agent <deadlines@your-verified-domain.com>
SEARCH_RESULTS_PER_QUERY=8
MAX_SEARCH_QUERIES_PER_RUN=10
MAX_PAGES_PER_RUN=30
WORKER_POLL_SECONDS=30
JOB_LEASE_MINUTES=60
SESSION_DAYS=14
COOKIE_SECURE=false
ALLOWED_HOSTS=localhost,127.0.0.1,testserver
LOG_LEVEL=INFO
