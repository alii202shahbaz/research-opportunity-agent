{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "fastapi",
  "regions": [
    "sin1"
  ],
  "functions": {
    "app/main.py": {
      "maxDuration": 300
    }
  },
  "schedules": {
    "oppfindagent-due-user-worker": {
      "schedule": "*/15 * * * *",
      "path": "/api/cron/worker",
      "requestMethod": "GET"
    }
  }
}
